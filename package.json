{
  "name": "ghar-jabo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "e2e": "playwright test",
    "size": "size-limit",
    "map": "python3 -I tools/build-map.py",
    "world": "python3 -I tools/build-world.py",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run size && npm run e2e"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@size-limit/file": "14.3.0",
    "@types/three": "0.187.0",
    "eslint": "10.14.0",
    "size-limit": "14.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "size-limit": [
    {
      "name": "game JS (gzipped)",
      "path": "dist/assets/*.js",
      "limit": "250 KB"
    }
  ]
}
